# Never commit your real private key. Use a dedicated Arc Testnet wallet only.
PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY
RPC_URL=https://rpc.testnet.arc.io

# Starts in simulation mode. Set to false to use the verified Arc Testnet flow.
DRY_RUN=true

# Optional safeguards and runtime tuning.
MIN_BALANCE_USDC=3
MAX_BUY_USDC=10
MAX_CYCLES=0
MAX_TOTAL_SPEND_USDC=50
SELL_PERCENT=25
PROFIT_TARGET_PERCENT=20
DISCOVERY_BLOCKS=5000
FAST_MODE=false

# Existing Flipt-hosted image URI used for launches. Supply your own uploaded URI if desired.
# Optional comma-separated Flipt-hosted icon URIs. Leave empty for unique generated identicons.`r`nCREATE_ICON_URIS=
# Raw token base units. 0 disables slippage protection.
MIN_TOKENS_OUT=0
MIN_USDC_OUT=0

DASHBOARD_PORT=8787
# Local tracking dashboard port.

# Telegram controls. Leave blank to disable remote controls.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Render web-service health port.
PORT=3000
CLOSE_LEGACY_POSITIONS=true
LEGACY_CLOSE_PERCENT=100
MAX_LEGACY_CLOSES_PER_CYCLE=5
AUTO_BOND=true
AUTO_UNBOND=true
MAX_BOND_USDC=1
BOND_TOKEN_PERCENT=10
UNBOND_PERCENT=100
UNBOND_AFTER_CYCLES=2
